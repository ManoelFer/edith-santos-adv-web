---
import Artigos from "@components/sections/Artigos.astro"
import Atendimento from "@components/sections/Atendimento.astro"
import AvaliacoesGoogle from "@components/sections/AvaliacoesGoogle.astro"
import Confianca from "@components/sections/Confianca.astro"
import Contato from "@components/sections/Contato.astro"
import Faq from "@components/sections/Faq.astro"
import Hero from "@components/sections/Hero.astro"
import Sobre from "@components/sections/Sobre.astro"
import Triagem from "@components/sections/Triagem.astro"
import { faq } from "@data/faq"
import { site } from "@data/site"
import BaseLayout from "@layouts/BaseLayout.astro"
import { faqPageSchema } from "@lib/schema"
---

<BaseLayout
  title="Advogada previdenciária: INSS e aposentadoria"
  description={site.description}
  schemas={[faqPageSchema(faq)]}
>
  <Hero />
  <Triagem />
  <Atendimento />
  <Sobre />
  {site.features.avaliacoesGoogle && <AvaliacoesGoogle />}
  <Confianca />
  <Faq />
  <Artigos />
  <Contato />
</BaseLayout>

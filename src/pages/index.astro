---
import Atendimento from "@components/sections/Atendimento.astro"
import Atuacao from "@components/sections/Atuacao.astro"
import Confianca from "@components/sections/Confianca.astro"
import Contato from "@components/sections/Contato.astro"
import Depoimentos from "@components/sections/Depoimentos.astro"
import Faq from "@components/sections/Faq.astro"
import Fases from "@components/sections/Fases.astro"
import Hero from "@components/sections/Hero.astro"
import Orientacoes from "@components/sections/Orientacoes.astro"
import Situacoes from "@components/sections/Situacoes.astro"
import Sobre from "@components/sections/Sobre.astro"
import { faq } from "@data/faq"
import { site } from "@data/site"
import BaseLayout from "@layouts/BaseLayout.astro"
import { faqPageSchema } from "@lib/schema"
---

<BaseLayout
  title="Advogada previdenciária: INSS e aposentadoria"
  description={site.description}
  schemas={[faqPageSchema(faq)]}
>
  <Hero />
  <Situacoes />
  <Atuacao />
  <Atendimento />
  <Fases />
  <Sobre />
  {site.features.depoimentos && <Depoimentos />}
  <Confianca />
  <Faq />
  <Orientacoes />
  <Contato />
</BaseLayout>

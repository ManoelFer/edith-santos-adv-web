---
import { Image } from "astro:assets"

import monograma from "@assets/logo-monograma.png"
import BeneficioCard from "@components/common/BeneficioCard.astro"
import CtaWhatsApp from "@components/common/CtaWhatsApp.astro"
import Section from "@components/common/Section.astro"
import SectionHeading from "@components/common/SectionHeading.astro"
import BaseLayout from "@layouts/BaseLayout.astro"
import { beneficiosPublicados, urlBeneficios } from "@lib/beneficios"
import { breadcrumbSchema } from "@lib/schema"

// Rota de resto em vez de index.astro: /beneficios-do-inss/ só é gerada quando existe
// pelo menos um benefício publicado (evita página vazia no Google).
export async function getStaticPaths() {
  const beneficios = await beneficiosPublicados()
  return beneficios.length > 0
    ? [{ params: { indice: undefined }, props: { beneficios } }]
    : []
}

const { beneficios } = Astro.props

const schema = breadcrumbSchema([
  { nome: "Início", caminho: "/" },
  { nome: "Benefícios", caminho: urlBeneficios },
])
---

<BaseLayout
  title="Benefícios do INSS: qual é o seu caso?"
  description="Aposentadoria, auxílio-doença, BPC/LOAS e pensão por morte: veja os sinais de quem pode ter direito e agende uma análise do seu caso com a advogada."
  schemas={[schema]}
>
  <Section reveal={false} glow="hero">
    {/* Timbre de fundo: monograma da logo, como na seção Sobre. */}
    <div
      slot="fundo"
      class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
      aria-hidden="true"
    >
      <Image
        src={monograma}
        alt=""
        width={640}
        densities={[1, 2]}
        format="webp"
        loading="lazy"
        class="absolute -top-8 -right-24 h-auto w-80 opacity-5 md:-top-12 md:-right-20 md:w-112 lg:right-0 lg:w-160"
      />
    </div>
    <SectionHeading
      as="h1"
      eyebrow="Benefícios do INSS"
      title="Qual benefício combina com a sua situação?"
      lead="Escolha o benefício e veja, em poucas perguntas, se o seu caso merece uma análise. Conteúdo informativo, revisado por mim."
    />
    <div class="entrada-itens mt-10 grid gap-4 md:grid-cols-2 lg:mt-14 xl:grid-cols-4">
      {beneficios.map((beneficio) => (
        <BeneficioCard beneficio={beneficio} nivel="h2" />
      ))}
    </div>
    <div class="mt-10">
      <CtaWhatsApp
        assunto="benefícios do INSS"
        origem="indice"
        titulo="Não sabe qual é o seu caso?"
        texto="Conte a sua situação pelo WhatsApp. Eu indico o caminho e agendo uma análise."
        semMargem
      />
    </div>
  </Section>
</BaseLayout>

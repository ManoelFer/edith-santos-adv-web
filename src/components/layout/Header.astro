---
import Button from "@components/common/Button.astro"
import Container from "@components/common/Container.astro"
import Icon from "@components/common/Icon.astro"
import Logo from "@components/common/Logo.astro"
import MobileMenu from "@components/layout/MobileMenu.astro"
import { site } from "@data/site"

const idMenu = "menu-mobile"
---

<header class="sticky top-0 z-40 border-b border-ink/8 shadow-[0_4px_4px_rgb(0_0_0/0.15),0_0_24px_rgb(255_255_255/0.06)]">
  {/* Liquid glass (teste): o filtro distorce o fundo borrado; no Safari o `url()` é ignorado e fica só o blur */}
  <svg aria-hidden="true" focusable="false" class="absolute size-0">
    <defs>
      <filter
        id="vidro-liquido"
        x="0"
        y="0"
        width="100%"
        height="100%"
        filterUnits="objectBoundingBox"
      >
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.003 0.007"
          numOctaves="1"
          result="ruido"
        />
        <feDisplacementMap
          in="SourceGraphic"
          in2="ruido"
          scale="40"
          xChannelSelector="R"
          yChannelSelector="G"
        />
      </filter>
    </defs>
  </svg>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 overflow-hidden"
  >
    <div class="absolute -inset-12 bg-page/45 backdrop-blur-xl backdrop-saturate-150 lg:[filter:url(#vidro-liquido)]"></div>
  </div>
  <Container class="relative z-10 flex min-h-18 items-center justify-between gap-6 lg:min-h-24">
    <a href="/" class="block flex-none rounded-sm">
      <Logo width={108} class="w-20 lg:w-27" />
    </a>

    <nav aria-label="Seções da página" class="flex items-center gap-8">
      <ul class="hidden gap-6 lg:flex">
        {site.nav.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={[
                "relative inline-flex min-h-11 items-center px-1 text-base text-muted no-underline transition-colors duration-300 hover:text-primary",
                "after:absolute after:inset-x-1 after:bottom-1.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-primary after:transition-transform after:duration-500 after:ease-suave hover:after:scale-x-100 focus-visible:after:scale-x-100",
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <div class="hidden sm:block">
        <Button href="/#contato">Falar comigo</Button>
      </div>

      <button
        type="button"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls={idMenu}
        class="inline-flex size-13 flex-none items-center justify-center rounded-sm border border-ink/20 text-ink transition-colors hover:border-ink/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary lg:hidden"
      >
        <Icon name="menu" />
      </button>
    </nav>
  </Container>

  <MobileMenu id={idMenu} />
</header>

---
import Button from "@components/common/Button.astro"
import Icon from "@components/common/Icon.astro"
import { site } from "@data/site"
import { whatsappUrl } from "@lib/whatsapp"

const whatsapp = whatsappUrl()
---

<!-- Celular: barra fixa com WhatsApp e ligação. Só aparece depois da primeira seção, que já tem os botões. -->
<div
  id="barra-contato"
  inert
  class="invisible translate-y-full opacity-0 transition-[opacity,translate,visibility] duration-300 ease-suave data-visivel:visible data-visivel:translate-y-0 data-visivel:opacity-100 fixed inset-x-0 bottom-0 z-30 border-t border-ink/10 bg-page/92 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-md md:hidden"
>
  <div class="flex gap-2.5">
    <Button
      href={whatsapp}
      size="lg"
      variant="whatsapp"
      event="whatsapp_click"
      class="flex-1 shadow-lg shadow-whatsapp/25"
    >
      <Icon name="whatsapp" />
      Falar no WhatsApp
    </Button>
    <a
      href={`tel:${site.telefoneE164}`}
      aria-label={`Ligar para ${site.telefone}`}
      data-event="phone_click"
      class="inline-flex size-14 flex-none items-center justify-center rounded-sm border border-ink/25 text-ink hover:border-ink/50 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      <Icon name="telefone" />
    </a>
  </div>
</div>

<!-- Tablet e desktop: botão flutuante -->
<a
  href={whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  data-event="whatsapp_click"
  class="fixed right-7 bottom-7 z-30 hidden min-h-14 items-center gap-3 rounded-full bg-whatsapp px-6 text-base font-semibold text-ink-strong no-underline shadow-xl shadow-whatsapp/30 transition-colors hover:bg-whatsapp-hover hover:text-ink-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink md:inline-flex"
>
  <Icon name="whatsapp" />
  Falar no WhatsApp
</a>

<script>
  import { iniciarBarraContato } from "@lib/barraContato"

  iniciarBarraContato()
</script>

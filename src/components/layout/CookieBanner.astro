---
import Button from "@components/common/Button.astro"
import { scriptAvisoCookies } from "@lib/scriptAvisoCookies"
---

<div
  id="aviso-cookies"
  role="region"
  aria-label="Aviso de cookies"
  class="border-b border-ink/10 bg-surface text-sm"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-4 md:flex-row md:items-center md:justify-between md:gap-6">
    <p class="text-ink-lead">
      Usamos cookies de publicidade (Google Ads) para medir o resultado dos
      nossos anúncios. Você pode aceitar ou recusar a qualquer momento. Veja a{" "}
      <a
        href="/politica-de-privacidade/"
        class="font-medium text-ink underline underline-offset-2 hover:text-primary"
      >
        Política de Privacidade
      </a>
      .
    </p>
    <div class="flex gap-3 md:flex-none">
      <Button variant="outline" id="cookies-recusar" class="flex-1">
        Recusar
      </Button>
      <Button variant="primary" id="cookies-aceitar" class="flex-1">
        Aceitar
      </Button>
    </div>
  </div>
</div>

<script is:inline set:html={scriptAvisoCookies}></script>
<script>
  import { iniciarAvisoCookies } from "@lib/cookieBanner"

  iniciarAvisoCookies()
</script>

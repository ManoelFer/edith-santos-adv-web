---
import NumberBadge from "@components/common/NumberBadge.astro"
import Section from "@components/common/Section.astro"
import SectionHeading from "@components/common/SectionHeading.astro"
import type { ItemBeneficio } from "@typings/conteudo"

interface Props {
  passos: ItemBeneficio[]
  titulo: string
  lead: string
}

const { passos, titulo, lead } = Astro.props
---

<!-- Passo a passo em linha do tempo (padrão "step by step" do GOV.UK) -->
<Section
  id="passo-a-passo"
  tone="alt"
  class="grid gap-9 lg:grid-cols-12 lg:gap-14"
>
  <SectionHeading
    size="md"
    eyebrow="Passo a passo"
    title={titulo}
    lead={lead}
    class="lg:sticky lg:top-32 lg:col-span-5 lg:self-start"
  />
  <!--
    A linha vertical que liga os números é o ::before da lista e desce até o
    fim do último passo; o ::after é o traço horizontal que fecha a linha,
    como no GOV.UK
  -->
  <ol
    class:list={[
      "relative grid gap-8 lg:col-span-7",
      "before:absolute before:top-5 before:bottom-px before:left-5 before:w-px before:bg-primary/30",
      "after:absolute after:bottom-0 after:left-2.5 after:h-px after:w-5 after:bg-primary/30",
    ]}
  >
    {passos.map(({ titulo, texto }, i) => (
      <li class="relative flex gap-5">
        <NumberBadge numero={String(i + 1)} class="relative bg-page-alt" />
        <div class="pt-1.5">
          <h3 class="text-lg font-semibold tracking-tight text-ink">
            {titulo}
          </h3>
          <p class="mt-1.5 text-base text-muted">{texto}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>

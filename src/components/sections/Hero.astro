---
import AvisoContato from "@components/common/AvisoContato.astro"
import Button from "@components/common/Button.astro"
import Container from "@components/common/Container.astro"
import DashList from "@components/common/DashList.astro"
import Eyebrow from "@components/common/Eyebrow.astro"
import VideoBackground from "@components/common/VideoBackground.astro"
import { site } from "@data/site"
import { whatsappUrl } from "@lib/whatsapp"

const selos = [
  "Inscrição ativa na OAB/GO",
  "Atuação exclusiva em previdenciário",
  `Atendimento 100% online, ${site.abrangencia}`,
]
---

<section class="relative flex -mt-18 min-h-svh flex-col justify-end overflow-hidden border-b border-ink/8 lg:-mt-24">
  <VideoBackground />
  <!-- Escurece o vídeo para o texto ter contraste em qualquer quadro. -->
  <div
    class="pointer-events-none absolute inset-0 bg-page/60 bg-linear-to-t from-page via-page/80 via-50% to-page/35 lg:bg-linear-to-r lg:from-page/90 lg:via-page/55 lg:via-50% lg:to-transparent"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-1/2 bg-linear-to-t from-page to-transparent lg:block"
    aria-hidden="true"
  ></div>

  <Container class="relative pt-32 lg:pt-44">
    <div class="max-w-2xl lg:pb-6">
      <Eyebrow class="mb-5 w-fit rounded-full bg-page/70 px-3.5 py-2 text-sm! font-medium text-primary-hover! ring-1 ring-primary/30 backdrop-blur-sm motion-safe:animate-entrada lg:mb-6.5">
        {site.area}
      </Eyebrow>
      <h1 class="motion-safe:animate-surgir motion-safe:animate-delay-80 font-serif text-4xl leading-display font-normal tracking-tight text-balance text-ink-strong sm:text-5xl lg:text-6xl xl:text-7xl">
        <em class="text-primary">Planejamento estratégico</em> para a sua
        aposentadoria e o seu benefício do INSS.
      </h1>
      <p class="mt-5 max-w-xl motion-safe:animate-surgir motion-safe:animate-delay-150 text-lg leading-relaxed text-ink-soft lg:mt-7 lg:text-xl">
        Sou advogada e atuo exclusivamente com direito previdenciário. Analiso o
        seu histórico de contribuições, mostro as possibilidades para o seu caso
        e acompanho seu processo do início ao fim.
      </p>
      <div class="mt-8 grid gap-2.5 motion-safe:animate-entrada motion-safe:animate-delay-300 sm:flex sm:flex-wrap sm:gap-3.5 lg:mt-10">
        <Button href={whatsappUrl()} size="lg" event="whatsapp_click">
          Agendar análise do meu caso
        </Button>
        <Button href="#contato" variant="outline" size="lg">
          Descrever meu caso
        </Button>
      </div>
      <AvisoContato class="mt-4 text-ink-lead motion-safe:animate-entrada motion-safe:animate-delay-300" />
    </div>

    <DashList
      itens={selos}
      class="mt-10 grid gap-3 border-t border-ink/15 pt-5.5 pb-8 motion-safe:animate-entrada motion-safe:animate-delay-450 md:grid-cols-3 md:gap-x-10 lg:mt-14 lg:pb-10"
    />
  </Container>
</section>

---
import Card from "@components/common/Card.astro"
import Section from "@components/common/Section.astro"
import SectionHeading from "@components/common/SectionHeading.astro"
import { situacoes } from "@data/situacoes"
---

<Section tone="alt" class="grid gap-8 lg:grid-cols-12 lg:gap-14">
  <SectionHeading
    eyebrow="Situações comuns"
    title="Talvez você esteja passando por isso"
    lead="Se alguma destas frases parece com a sua, vale conversar antes de tomar qualquer decisão sozinho."
    class="lg:col-span-5"
  />
  <ul class="reveal-itens grid gap-3.5 sm:grid-cols-2 lg:col-span-7">
    {situacoes.map(({ titulo, descricao }) => (
      <Card as="li" accent="left" hover>
        <h3 class="mb-2 text-lg font-semibold tracking-tight text-ink">
          {titulo}
        </h3>
        <p class="text-base text-muted">{descricao}</p>
      </Card>
    ))}
  </ul>
</Section>

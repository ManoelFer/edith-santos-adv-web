---
import AuthorCard from "@components/common/AuthorCard.astro"
import Icon from "@components/common/Icon.astro"
import Section from "@components/common/Section.astro"
import { formatarData } from "@lib/formatarData"
import type { Fonte } from "@typings/conteudo"

interface Props {
  fontes: Fonte[]
  revisado: Date
}

const { fontes, revisado } = Astro.props
---

<Section id="fontes" tone="alt" class="grid gap-8 lg:grid-cols-12 lg:gap-14">
  <div class="lg:col-span-5">
    <AuthorCard />
  </div>

  <details class="group lg:col-span-7">
    <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 border-b border-ink/14 text-base font-semibold text-ink-soft hover:text-ink-strong [&::-webkit-details-marker]:hidden">
      Base legal deste texto
      <span class="text-xl leading-none text-primary" aria-hidden="true">
        <span class="group-open:hidden">+</span>
        <span class="hidden group-open:inline">−</span>
      </span>
    </summary>
    <p class="mt-4 text-sm text-subtle">
      Texto revisado em{" "}
      <time datetime={revisado.toISOString()}>{formatarData(revisado)}</time>.
      As regras mudam: confira sempre a data. Conteúdo informativo, que não
      substitui a análise individual do caso.
    </p>
    <ul class="mt-3 border-t border-ink/10">
      {fontes.map(({ rotulo, url }) => (
        <li class="border-b border-ink/6">
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 items-center justify-between gap-4 py-2.5 text-base break-words"
          >
            <span>
              {rotulo}
              <span class="sr-only"> (abre em nova aba)</span>
            </span>
            <Icon name="externo" class="size-4.5 text-subtle" />
          </a>
        </li>
      ))}
    </ul>
  </details>
</Section>

---
import { Image } from "astro:assets"

import monograma from "@assets/logo-monograma.png"
import Container from "@components/common/Container.astro"
import Eyebrow from "@components/common/Eyebrow.astro"
import Icon from "@components/common/Icon.astro"
import { confiancaIntro, credenciais } from "@data/credenciais"

// Cartões fixos que se sobrepõem ao rolar (sticky). Sem `overflow` nem `contain`
// nos ancestrais do `ol`: quebram o sticky. O `overflow-hidden` fica no próprio
// cartão (só corta o timbre). Todos têm a mesma altura mínima, e o texto da
// introdução cabe nela, para o cartão novo cobrir o anterior por inteiro.
const cartao =
  "empilha:sticky empilha:empilha-topo relative isolate flex min-h-88 flex-col justify-center overflow-hidden rounded-sm border border-ink/10 border-t-primary/55 bg-surface p-5 shadow-2xl shadow-black/40 sm:p-7 lg:min-h-96 lg:p-10"
---

<section
  id="confianca"
  class="relative isolate overflow-x-clip border-b border-ink/8 bg-page-alt"
>
  <!-- Timbre de fundo: aparece nas laterais e nos vãos entre os cartões. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
    aria-hidden="true"
  >
    <Image
      src={monograma}
      alt=""
      width={640}
      densities={[1, 2]}
      format="webp"
      loading="lazy"
      class="absolute top-12 -left-24 h-auto w-80 opacity-5 md:w-112 lg:top-24 lg:-left-20 lg:w-160"
    />
  </div>
  <Container class="py-12 md:py-20 lg:py-28">
    <ol class="grid gap-4 lg:gap-6">
      <li style="--i: 0" class:list={cartao}>
        <Image
          src={monograma}
          alt=""
          width={480}
          densities={[1, 2]}
          format="webp"
          loading="lazy"
          aria-hidden="true"
          class="pointer-events-none absolute -right-12 -bottom-12 -z-10 h-auto w-56 opacity-5 select-none lg:-right-8 lg:-bottom-16 lg:w-80"
        />
        <Eyebrow class="mb-4 md:mb-5">{confiancaIntro.eyebrow}</Eyebrow>
        <h2 class="max-w-3xl font-serif text-3xl leading-display font-normal tracking-tight text-balance text-ink-strong md:text-4xl lg:text-5xl">
          <span class="mr-2 text-primary lg:mr-3">{credenciais.length}</span>
          {confiancaIntro.titulo}
        </h2>
        <p class="mt-4 max-w-2xl text-muted md:mt-5">{confiancaIntro.texto}</p>
      </li>

      {credenciais.map(({ titulo, descricao, links, alerta }, indice) => (
        <li
          style={`--i: ${indice + 1}`}
          class:list={[
            cartao,
            "gap-4 sm:flex-row sm:items-center sm:justify-start sm:gap-8",
            alerta && "border-primary/60",
          ]}
        >
          <Image
            src={monograma}
            alt=""
            width={480}
            densities={[1, 2]}
            format="webp"
            loading="lazy"
            aria-hidden="true"
            class="pointer-events-none absolute -right-12 -bottom-12 -z-10 h-auto w-56 opacity-5 select-none lg:-right-8 lg:-bottom-16 lg:w-80"
          />
          <span
            class="font-serif text-5xl leading-none text-primary/70 sm:w-24 sm:flex-none sm:text-7xl lg:w-32 lg:text-8xl"
            aria-hidden="true"
          >
            {String(indice + 1).padStart(2, "0")}
          </span>
          <div class="max-w-2xl">
            <h3 class="flex items-center gap-3 font-serif text-2xl leading-display font-normal text-ink-strong lg:text-4xl">
              {alerta && <Icon name="alerta" class="size-7 text-primary" />}
              {titulo}
            </h3>
            <p class="mt-3 text-base text-ink-soft lg:text-lg">{descricao}</p>
            {links && (
              <ul class="mt-2 flex flex-wrap gap-x-6">
                {links.map(({ label, href, evento }) => (
                  <li>
                    <a
                      href={href}
                      data-event={evento}
                      class="inline-flex min-h-11 items-center text-base break-words"
                      {...(href.startsWith("http") && {
                        target: "_blank",
                        rel: "noopener noreferrer",
                      })}
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </Container>
</section>

---
import { Image } from "astro:assets"

import retrato from "@assets/edith-santos-advogada.png"

/** Foto redonda pequena da advogada, para dentro de botões de contato. */
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<Image
  src={retrato}
  alt=""
  width={40}
  height={40}
  densities={[1, 2]}
  fit="cover"
  position="top"
  loading="lazy"
  class:list={[
    "size-9 flex-none rounded-full border-2 border-page/25 bg-page-alt object-cover object-top",
    className,
  ]}
/>

---
import Icon from "@components/common/Icon.astro"

interface Props {
  itens: readonly string[]
  class?: string
}

const { itens, class: className } = Astro.props
---

<ul class:list={["grid gap-3 text-base text-ink-lead", className]}>
  {itens.map((item) => (
    <li class="flex gap-3">
      <Icon name="check" class="mt-0.5 size-5 text-primary" />
      <span>{item}</span>
    </li>
  ))}
</ul>

---
import { Image } from "astro:assets"

import { type Beneficio, urlBeneficio } from "@lib/beneficios"

interface Props {
  beneficio: Beneficio
  /** Nível do título conforme a página (h2 na listagem, h3 nas demais). */
  nivel?: "h2" | "h3"
}

const { beneficio, nivel: Titulo = "h3" } = Astro.props
const { h1, eyebrow, description, imagem } = beneficio.data
---

<!--
  Card inteiro clicável: o link é o título e o ::after cobre o card.
  Alturas fixas de rótulo (2 linhas), título (3) e descrição (4): o "Ler sobre" fica
  na mesma linha em todos os cards.
-->
<article
  class:list={[
    "relative flex flex-col overflow-hidden rounded-sm border border-ink/8 bg-surface",
    "transition-colors duration-200 hover:border-primary/45 hover:bg-field",
    "has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary",
  ]}
>
  <Image
    src={imagem}
    alt=""
    format="svg"
    class="aspect-16/10 h-auto w-full border-b border-ink/8 object-cover"
  />
  <div class="flex flex-1 flex-col p-5 md:p-6">
    <p class="mb-2.5 text-xs tracking-eyebrow text-primary uppercase md:min-h-8">
      {eyebrow}
    </p>
    <Titulo class="mb-3 font-serif text-2xl leading-tight font-normal text-ink-strong md:min-h-22.5">
      <a
        href={urlBeneficio(beneficio.id)}
        class="text-ink-strong no-underline after:absolute after:inset-0 focus-visible:outline-none"
      >
        {h1}
      </a>
    </Titulo>
    <p class="text-base text-muted md:min-h-24">{description}</p>
    <p class="mt-auto pt-4 text-base text-primary" aria-hidden="true">
      Ler sobre o benefício →
    </p>
  </div>
</article>

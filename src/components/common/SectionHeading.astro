---
import Eyebrow from "@components/common/Eyebrow.astro"

interface Props {
  eyebrow: string
  title: string
  lead?: string
  /** Texto do lead só no celular; a partir de `md:` vale `lead`. */
  leadMobile?: string
  align?: "start" | "center"
  size?: "lg" | "md"
  /** h1 quando o título da seção é o título da página. */
  as?: "h1" | "h2"
  class?: string
}

const {
  eyebrow,
  title,
  lead,
  leadMobile,
  align = "start",
  size = "lg",
  as: Titulo = "h2",
  class: className,
} = Astro.props

const sizes = {
  lg: "text-3xl md:text-4xl lg:text-5xl",
  md: "text-3xl lg:text-4xl",
} as const
---

<div
  class:list={[
    align === "center" ? "mx-auto max-w-2xl text-center" : "max-w-2xl",
    className,
  ]}
>
  <Eyebrow class="mb-4 md:mb-5">{eyebrow}</Eyebrow>
  <Titulo
    class:list={[
      "font-serif leading-display font-normal tracking-tight text-balance text-ink-strong",
      sizes[size],
    ]}
  >
    {title}
  </Titulo>
  {lead && leadMobile && (
    <>
      <p class="mt-4 text-muted md:hidden">{leadMobile}</p>
      <p class="mt-5 hidden text-muted md:block">{lead}</p>
    </>
  )}
  {lead && !leadMobile && <p class="mt-4 text-muted md:mt-5">{lead}</p>}
  <slot />
</div>

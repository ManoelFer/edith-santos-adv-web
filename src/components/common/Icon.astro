---
import type { IconName } from "@typings/icon"

interface Props {
  name: IconName
  class?: string
}

const { name, class: className } = Astro.props

// Traços de 1.5px, desenhados no grid 24×24 (mesmo traço do layout)
const icones: Record<IconName, string> = {
  relogio: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2.2"/>',
  linhas: '<path d="M4 7h16M4 12h11M4 17h7"/>',
  ponto: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2.5"/>',
  arco: '<path d="M7 20V9a5 5 0 0 1 10 0v11"/><path d="M4 20h16"/>',
  meia: '<path d="M3.5 16.5a8.5 8.5 0 0 1 17 0"/><path d="M3.5 20h17"/>',
  quadro:
    '<rect x="4" y="4" width="16" height="16" rx="1"/><path d="M4 10h16"/>',
  diagonal:
    '<rect x="4" y="4" width="16" height="16" rx="1"/><path d="M4 20 20 4"/>',
  seta: '<path d="M4 18 12 6l8 12"/><path d="M4 21h16"/>',
  whatsapp:
    '<path d="M4 20.5l1.3-3.9A8.5 8.5 0 1 1 8.4 19.4z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2z"/>',
  telefone:
    '<path d="M5.5 3.5h3l1.5 4.2-2 1.4a11 11 0 0 0 6.9 6.9l1.4-2 4.2 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3.5 5.5a2 2 0 0 1 2-2z"/>',
  menu: '<path d="M4 8.5h16M4 15.5h16"/>',
  fechar: '<path d="M6 6l12 12M18 6 6 18"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
}
---

<svg
  class:list={["size-6 flex-none", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icones[name]}
/>

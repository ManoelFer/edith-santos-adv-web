---
import CapaArtigo from "@components/common/CapaArtigo.astro"
import { type Artigo, textoDeLeitura, urlArtigo } from "@lib/artigos"
import { formatarData } from "@lib/formatarData"

interface Props {
  artigo: Artigo
  /**
   * `destaque`: o mais recente, em largura total, capa e texto lado a lado.
   * `linha`: capa e texto lado a lado, menor; para quando sobra um único card.
   */
  variante?: "padrao" | "destaque" | "linha"
  /** Nível do título conforme a página (h2 na listagem, h3 na Home e no fim do artigo). */
  nivel?: "h2" | "h3"
}

const { artigo, variante = "padrao", nivel: Titulo = "h3" } = Astro.props
const { title, description, date } = artigo.data
const destaque = variante === "destaque"
const lado = destaque || variante === "linha"
---

<!--
  Card inteiro clicável: o link é o título e o ::after cobre o card.
  No destaque, o texto fica à esquerda e a capa à direita (desktop).
-->
<article
  class:list={[
    "group relative overflow-hidden rounded-sm border border-ink/8 bg-surface",
    "transition duration-300 ease-suave hover:border-primary/45 hover:bg-field",
    "motion-safe:hover:-translate-y-1 motion-safe:hover:shadow-xl motion-safe:hover:shadow-black/40 motion-safe:active:scale-99",
    "has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary",
    destaque && "grid lg:grid-cols-2",
    variante === "linha" && "grid md:grid-cols-2",
    !lado && "flex flex-col",
  ]}
>
  <div
    class:list={[
      "overflow-hidden border-b border-ink/8",
      destaque && "lg:order-2 lg:border-b-0 lg:border-l",
      variante === "linha" && "md:order-2 md:border-b-0 md:border-l",
    ]}
  >
    <CapaArtigo
      artigo={artigo}
      tamanho={destaque ? "destaque" : "padrao"}
      class={lado ? "h-full" : undefined}
    />
  </div>

  <div
    class:list={[
      "flex flex-1 flex-col p-5 md:p-6",
      destaque && "lg:justify-center lg:p-8 xl:p-10",
      variante === "linha" && "md:justify-center",
    ]}
  >
    <p class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm tracking-wider text-primary uppercase">
      {destaque && (
        <span class="rounded-full border border-primary/35 bg-primary/8 px-3 py-1 text-xs tracking-eyebrow">
          Mais recente
        </span>
      )}
      <span>
        <time datetime={date.toISOString()}>{formatarData(date)}</time>
        <span aria-hidden="true"> · </span>
        {textoDeLeitura(artigo)}
      </span>
    </p>
    <Titulo
      class:list={[
        "mb-3 font-serif leading-tight font-normal text-balance text-ink-strong",
        destaque ? "text-3xl md:text-4xl" : "text-2xl",
      ]}
    >
      <a
        href={urlArtigo(artigo.id)}
        class="text-ink-strong no-underline after:absolute after:inset-0 focus-visible:outline-none"
      >
        {title}
      </a>
    </Titulo>
    <p class:list={["text-muted", "max-w-prose text-base"]}>{description}</p>
    <p class="mt-auto pt-5 text-base text-primary" aria-hidden="true">
      Ler o artigo{" "}
      <span class="inline-block transition duration-300 ease-suave group-hover:translate-x-1">
        →
      </span>
    </p>
  </div>
</article>

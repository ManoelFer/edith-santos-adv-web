---
import { Image } from "astro:assets"

import retrato from "@assets/edith-santos-advogada.png"
import { site } from "@data/site"

interface Props {
  class?: string
}

const { class: className = "mt-12" } = Astro.props
---

<aside
  aria-label="Sobre a autora"
  class:list={[
    "flex max-w-3xl items-center gap-5 rounded-md border border-ink/10 bg-surface-2 p-5",
    className,
  ]}
>
  <Image
    src={retrato}
    alt={`Foto de ${site.nomeCompleto}`}
    width={80}
    height={80}
    densities={[1, 2]}
    fit="cover"
    position="top"
    class="size-20 flex-none rounded-full bg-page-alt object-cover object-top"
  />
  <div>
    <p class="font-semibold text-ink">{site.nomeCompleto}</p>
    <p class="text-base text-muted">
      {site.profissao} · {site.oab} · {site.area}
    </p>
    <a href="/#sobre" class="mt-1 inline-flex min-h-11 items-center text-base">
      Conheça a advogada
    </a>
  </div>
</aside>

---
import Button from "@components/common/Button.astro"
import { mensagemSobre, whatsappUrl } from "@lib/whatsapp"

/**
 * Chamada para o WhatsApp no meio de um artigo (MDX). Usa a mensagem pronta
 * com o assunto do artigo e dispara a conversão `whatsapp_click`.
 */
interface Props {
  /** Assunto que entra na mensagem pronta ("...do meu caso sobre <assunto>."). */
  assunto: string
  titulo?: string
  texto?: string
  /** Sem a margem de cima e de baixo (quando a seção já dá o espaço). */
  semMargem?: boolean
}

const {
  assunto,
  titulo = "Quer saber se o seu caso se enquadra?",
  texto = "Me conte a sua situação pelo WhatsApp. Eu explico, com base nos documentos, quais são as possibilidades do seu caso.",
  semMargem = false,
} = Astro.props
---

<aside
  aria-label="Fale com a advogada"
  class:list={[
    !semMargem && "my-10",
    "rounded-md border border-ink/10 border-l-2 border-l-primary bg-surface-2 p-5 md:p-6",
  ]}
>
  <p class="mb-2! text-lg font-semibold text-ink">{titulo}</p>
  <p class="mb-5! text-ink-soft">{texto}</p>
  <Button
    href={whatsappUrl(mensagemSobre(assunto))}
    event="whatsapp_click"
    class="w-full sm:w-auto"
  >
    Falar com a advogada no WhatsApp
  </Button>
</aside>

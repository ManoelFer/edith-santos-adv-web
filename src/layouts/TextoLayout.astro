---
import type { ImageMetadata } from "astro"

import Container from "@components/common/Container.astro"
import Eyebrow from "@components/common/Eyebrow.astro"
import Prose from "@components/common/Prose.astro"
import BaseLayout from "@layouts/BaseLayout.astro"
import { formatarData } from "@lib/formatarData"

interface Props {
  title: string
  description: string
  eyebrow: string
  /** Data da última revisão do texto. */
  atualizado?: Date
  image?: ImageMetadata
  schemas?: Record<string, unknown>[]
}

const { title, description, eyebrow, atualizado, image, schemas } = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  schemas={schemas}
>
  <article class="border-b border-ink/8">
    <Container class="py-12 md:py-20">
      <header class="max-w-3xl">
        <Eyebrow class="mb-5">{eyebrow}</Eyebrow>
        <h1 class="font-serif text-4xl leading-display font-normal tracking-tight text-balance text-ink-strong md:text-5xl">
          {title}
        </h1>
        {atualizado && (
          <p class="mt-5 text-sm text-subtle">
            Atualizado em{" "}
            <time datetime={atualizado.toISOString()}>
              {formatarData(atualizado)}
            </time>
          </p>
        )}
        <slot name="cabecalho" />
      </header>
      <Prose class="mt-10">
        <slot />
      </Prose>
      <slot name="rodape" />
    </Container>
  </article>
</BaseLayout>

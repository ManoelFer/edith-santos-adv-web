---
import type { ImageMetadata } from "astro"
import { Font, getImage } from "astro:assets"

import ogPadrao from "@assets/og-edith-santos.jpg"
import Analytics from "@components/layout/Analytics.astro"
import ContactBar from "@components/layout/ContactBar.astro"
import Footer from "@components/layout/Footer.astro"
import Header from "@components/layout/Header.astro"
import TopBar from "@components/layout/TopBar.astro"
import { site } from "@data/site"
import { legalServiceSchema } from "@lib/schema"

import "@styles/global.css"

interface Props {
  /** Tema da página; o nome do site entra no fim. */
  title: string
  /** 120 a 155 caracteres, única por página. */
  description: string
  /** Imagem de compartilhamento (1200×630). */
  image?: ImageMetadata
  /** Tira a página do Google (obrigado, testes). */
  noindex?: boolean
  /** Blocos JSON-LD extras da página (FAQPage, Article...). */
  schemas?: Record<string, unknown>[]
}

const {
  title,
  description,
  image = ogPadrao,
  noindex = false,
  schemas = [],
} = Astro.props

const tituloCompleto = `${title} | ${site.name}`
const canonical = new URL(Astro.url.pathname, Astro.site)
const og = await getImage({
  src: image,
  width: 1200,
  height: 630,
  format: "jpg",
})
const ogUrl = new URL(og.src, Astro.site).toString()

const jsonLd = [legalServiceSchema(ogUrl), ...schemas]
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#08090a" />
    <link rel="author" href="/humans.txt" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-public-sans" preload />
    <Font cssVariable="--font-instrument-serif" />
    <Analytics />

    {jsonLd.map((schema) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      ></script>
    ))}
  </head>
  <body class="min-h-dvh">
    <a
      href="#conteudo"
      class="sr-only z-50 rounded-sm bg-primary px-4 py-3 font-semibold text-page focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Pular para o conteúdo
    </a>
    <TopBar />
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <ContactBar />

    <script>
      import { iniciarEventos } from "@lib/analytics"
      import { iniciarReveal } from "@lib/reveal"

      iniciarReveal()
      iniciarEventos()
    </script>
  </body>
</html>

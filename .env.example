# Chave da Places API (New), usada só por `yarn avaliacoes`. Copie para .env.
GOOGLE_PLACES_API_KEY=

# Hello World CMS (orientações). O CMS_TOKEN sai do painel do CMS, em
# Sites > Edith > Integração. No build da Cloudflare e do GitHub vão como
# variáveis de ambiente; aqui só se quiser ver os artigos no `yarn dev`.
CMS_URL=https://cms.helloworldestudio.com.br
CMS_SITE_ID=
CMS_TOKEN=
